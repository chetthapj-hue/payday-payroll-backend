# Local development only. Real values belong in server/.env (ignored) or Render Environment.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/payday_db
NODE_ENV=development
PORT=3000
TRUST_PROXY=0
COOKIE_SECURE=false
# Render: NODE_ENV=production, TRUST_PROXY=1, COOKIE_SECURE=true, internal DATABASE_URL.
# Render supplies PORT. Do not copy this local PORT override to Render.

# Independent attendance scheduler (off by default)
PAYDAY_AUTO_ATTENDANCE=false
