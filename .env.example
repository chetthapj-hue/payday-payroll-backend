# Render Environment Variables: examples only; do not commit real credentials.
NODE_ENV=production
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_DB_HOST:5432/YOUR_DATABASE
TRUST_PROXY=1
COOKIE_SECURE=true
# Render supplies PORT at runtime; do not hardcode it in the dashboard.
# PORT=10000
# Node comes from .node-version. No VITE_* database or session secrets are needed.
